# Скопируй этот файл в .env и заполни свои ключи.
# .env НЕ должен попасть в git!

# Groq — llama-3.1-8b, llama-3.3-70b
# Получить: https://console.groq.com/keys
# Несколько ключей через запятую — автоматическая ротация при wait > 10s:
GROQ_API_KEY=gsk_key1,gsk_key2,gsk_key3

# Mistral API — mistral-small
# Получить: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Models — gpt-4o-mini
# Получить: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Together AI — qwen-2.5-7b, qwen-2.5-14b, qwen-2.5-32b
# Получить: https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local vLLM — mistral-small-3.2, qwen3-32b-local, llama-3.1-8b-local
# Запуск сервера: python serve_local.py --model <key>
# Значение может быть любой строкой (vLLM принимает любой ключ по умолчанию)
LOCAL_API_KEY=EMPTY
