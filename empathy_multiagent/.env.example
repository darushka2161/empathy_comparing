# Скопируй этот файл в .env и заполни свои ключи.
# .env НЕ должен попасть в git!

# Local vLLM — mistral-small-3.2, qwen3-32b-local, llama-3.1-8b-local
# Запуск сервера: python serve_local.py --model <key>
# Значение может быть любой строкой (vLLM принимает любой ключ по умолчанию)
LOCAL_API_KEY=EMPTY